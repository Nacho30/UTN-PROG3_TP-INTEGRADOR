@baseUrl = http://127.0.0.1:8000

### ==========================================================
### MÓDULO: PROVEEDORES - HU-01: Registrar un proveedor
### Ejecutar en orden (el servidor arranca con 2 proveedores
### precargados: id=1 PROV-001 e id=2 PROV-002).
### ==========================================================

### 1. Crear proveedor -> 201 Created (devuelve id=3)
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PROV-003",
  "razon_social": "Ferretería Industrial Cuyo",
  "cuit": "20-12345678-9",
  "email": "compras@ferrecuyo.com",
  "telefono": "261-5550000",
  "activo": true
}

### 2. Crear proveedor solo con campos obligatorios -> 201 Created
# email y telefono toman "" y activo toma true por defecto
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PROV-004",
  "razon_social": "Logística Norte",
  "cuit": "30-11111111-1"
}

### 3. ERROR 409 - Código duplicado (RN-02)
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PROV-001",
  "razon_social": "Otro Proveedor S.A.",
  "cuit": "30-22222222-2"
}

### 4. ERROR 422 - Código vacío (RN-01)
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "",
  "razon_social": "Proveedor Sin Código",
  "cuit": "30-33333333-3"
}

### 5. ERROR 422 - Razón social con menos de 3 caracteres (RN-03)
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PROV-005",
  "razon_social": "AB",
  "cuit": "30-44444444-4"
}

### 6. ERROR 422 - CUIT demasiado corto (min_length=11)
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PROV-006",
  "razon_social": "Proveedor CUIT Corto",
  "cuit": "123"
}

### 7. ERROR 422 - Faltan campos obligatorios
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "email": "sin-datos@mail.com"
}
